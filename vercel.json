{
  "version": 2,
  "builds": [
    {
      "src": "spin-api/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "spin-client/public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/spin-api/server.js"
    },
    {
      "src": "/socket.io/(.*)",
      "dest": "/spin-api/server.js"
    },
    {
      "src": "/health",
      "dest": "/spin-api/server.js"
    },
    {
      "src": "/api-docs",
      "dest": "/spin-api/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/spin-client/public/$1"
    }
  ],
